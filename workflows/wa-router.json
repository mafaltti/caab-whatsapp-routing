    {
      "parameters": {
        "jsCode": "const msg = $('Check Dedupe Result').first().json;\nconst pgItems = $input.all();\n\nlet hasValidState = false;\nlet active_flow = null;\nlet step = null;\nlet data = {};\n\nif (pgItems.length > 0 && pgItems[0].json && pgItems[0].json.active_flow) {\n  const stateRow = pgItems[0].json;\n  const expiresAt = stateRow.expires_at ? new Date(stateRow.expires_at) : null;\n  const now = new Date();\n\n  if (!expiresAt || expiresAt > now) {\n    hasValidState = true;\n    active_flow = stateRow.active_flow;\n    step = stateRow.step;\n    data = stateRow.data || {};\n  }\n}\n\nreturn [{\n  json: {\n    user_id: msg.user_id,\n    instance: msg.instance,\n    text: msg.text,\n    message_id: msg.message_id,\n    pushName: msg.pushName,\n    raw: msg.raw,\n    hasValidState,\n    active_flow,\n    step,\n    data\n  }\n}];"
      },
