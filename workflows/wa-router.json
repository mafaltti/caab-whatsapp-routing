    {
      "parameters": {
        "content": "## Phase A: Receive & Filter\n\nWebhook receives Evolution API messages.upsert events.\nNormalizes payload, filters out fromMe and group messages."
      },
      "id": "sticky-a",
      "name": "Phase A - Receive & Filter",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -96,
        64
      ]
    },
    {
      "parameters": {
        "content": "## Phase B: Dedupe & Persist\n\nSaves inbound message to chat_messages.\nDeduplicates using message_id (ON CONFLICT)."
      },
      "id": "sticky-b",
      "name": "Phase B - Dedupe & Persist",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        688,
        64
      ]
    },
    {
      "parameters": {
        "content": "## Phase C: State Machine\n\nLoads conversation_state for active flow.\nIf valid (not expired), routes to existing sub-workflow.\nOtherwise, falls through to LLM classification."
      },
      "id": "sticky-c",
      "name": "Phase C - State Machine",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1344,
        64
      ]
    },
    {
      "parameters": {
        "content": "## Phase D: Greeting + LLM Classification\n\nSends Caabot greeting (first-time vs returning user).\nLoads last 10 messages for context.\nUses Groq (Llama 3.3 70B) to classify intent.\nRoutes to sub-workflow based on classification.\n\"unclear\" intents (greetings, vague messages) stop after greeting.\nLow confidence (< 0.70) routes to human."
      },
      "id": "sticky-d",
      "name": "Phase D - LLM Classification",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1792,
        480
      ]
    },
    {
      "id": "code-greeting",
      "name": "Compose Greeting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2208,
        704
      ],
      "parameters": {
        "jsCode": "const msg = $('Flatten State Row').first().json;\nconst contextRow = $input.first().json;\nconst hasHistory = contextRow.has_history || false;\n\n// Check if last outbound message was already a greeting\nconst context = contextRow.conversation_context || '';\nconst lines = context.split('\\n');\nconst lastOutbound = lines.filter(l => l.startsWith('out: ')).pop() || '';\n\nlet greeting = '';\nlet skipGreeting = false;\n\nif (lastOutbound.includes('Eu sou a Caabot') || lastOutbound.includes('diga de forma direta')) {\n  // Already greeted recently - skip sending another greeting\n  skipGreeting = true;\n} else if (hasHistory) {\n  greeting = 'Bom ter voce aqui de novo! \\ud83d\\udc4bEu sou a Caabot, a atendente virtual da CAAB. Me diz como posso te ajudar.';\n} else {\n  greeting = 'Ola! \\ud83d\\udc4bEu sou a Caabot, a atendente virtual da CAAB. Me diz como posso te ajudar.';\n}\n\nreturn [{\n  json: {\n    ...msg,\n    conversation_context: contextRow.conversation_context,\n    has_history: hasHistory,\n    greeting_text: greeting,\n    skip_greeting: skipGreeting\n  }\n}];"
      }
    },
