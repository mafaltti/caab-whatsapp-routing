      "id": "wh-1",
      "name": "Evolution - messages.upsert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        304
      ],
      "webhookId": "5af27413-0629-498c-96b0-d839cf6e3706"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Only process messages.upsert events — skip all others\nif (body.event !== 'messages.upsert') {\n  return [{\n    json: {\n      user_id: '',\n      instance: body.instance || '',\n      message_id: '',\n      fromMe: true,\n      isGroup: false,\n      text: '',\n      pushName: '',\n      raw: body,\n      _skipped: true\n    }\n  }];\n}\n\nconst data = body.data;\nconst key = data.key;\nconst msg = data.message;\n\nconst remoteJid = key.remoteJid || '';\nconst isGroup = remoteJid.endsWith('@g.us');\nconst fromMe = key.fromMe || false;\nconst message_id = key.id;\nconst instance = body.instance;\n\n// Handle WhatsApp LID format: remoteJid may be a LID (e.g. 12345@lid)\n// In that case, the actual phone number is in body.sender\nlet user_id;\nif (remoteJid.endsWith('@lid')) {\n  const sender = body.sender || '';\n  user_id = sender.replace(/@s\\.whatsapp\\.net$/, '');\n} else {\n  user_id = remoteJid.replace(/@s\\.whatsapp\\.net$/, '').replace(/@g\\.us$/, '');\n}\n\nlet text = '';\nif (msg) {\n  text = msg.conversation\n    || (msg.extendedTextMessage && msg.extendedTextMessage.text)\n    || (msg.imageMessage && msg.imageMessage.caption)\n    || (msg.videoMessage && msg.videoMessage.caption)\n    || (msg.documentMessage && msg.documentMessage.caption)\n    || '';\n}\n\nreturn [{\n  json: {\n    user_id,\n    instance,\n    message_id,\n    fromMe,\n    isGroup,\n    text,\n    pushName: data.pushName || '',\n    raw: body\n  }\n}];"
      },
