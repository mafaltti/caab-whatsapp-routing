    {
      "parameters": {
        "jsCode": "const msg = $('Flatten State Row').first().json;\nconst greetingData = $('Compose Greeting').first().json;\nconst context = greetingData.conversation_context || 'Sem historico anterior';\n\n// Rotate Groq API keys to distribute rate limits (4 keys = 120 RPM)\nconst groqKeys = [\n  'GROQ_API_KEY_1',\n  'GROQ_API_KEY_2',\n  'GROQ_API_KEY_3',\n  'GROQ_API_KEY_4'\n];\nconst groq_api_key = groqKeys[Math.floor(Math.random() * groqKeys.length)];\n\nconst systemPrompt = `Voce e um classificador de mensagens para a Caixa de Assistencia dos Advogados da Bahia (CAAB). Classifique a intencao do usuario em uma das categorias abaixo.\n\nCategorias:\n- support: problemas tecnicos, reclamacoes, duvidas sobre procedimentos\n- sales: interesse em novos servicos, planos, precos\n- scheduling: agendamento, reagendamento, cancelamento de consultas\n- billing: pagamentos, boletos, notas fiscais, cobrancas\n- human: quando nenhuma categoria se aplica ou usuario pede atendente\n- unclear: saudacoes simples (oi, ola, bom dia), mensagens vagas sem intencao clara\n\nResponda APENAS com JSON valido: {\"route\": \"<categoria>\", \"confidence\": <0.0-1.0>, \"reason\": \"<motivo>\"}`;\n\nconst userMessage = `Historico recente:\\n${context}\\n\\nMensagem atual do usuario: ${msg.text}`;\n\nreturn [{\n  json: {\n    ...msg,\n    groq_api_key,\n    llm_body: {\n      model: 'llama-3.3-70b-versatile',\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: userMessage }\n      ],\n      temperature: 0,\n      max_tokens: 200\n    }\n  }\n}];"
      },
      "id": "code-prompt",
      "name": "Build LLM Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3104,
        704
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $json.groq_api_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.llm_body) }}",
        "options": {}
      },
      "id": "http-llm",
      "name": "LLM Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3328,
        704
      ],
      "retryOnFail": false,
      "maxTries": 5,
      "waitBetweenTries": 30000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst msgData = $('Flatten State Row').first().json;\n\nlet route = 'human';\nlet confidence = 0;\nlet reason = 'Parse error - defaulting to human';\n\n// Check if LLM call failed (continueOnFail produces error field)\nif (item.error || !item.choices) {\n  return [{\n    json: {\n      ...msgData,\n      route: 'human',\n      confidence: 0,\n      reason: 'LLM unavailable (' + (item.error?.message || item.error || 'no response') + ') - routing to human'\n    }\n  }];\n}\n\ntry {\n  let responseText = item.choices[0].message.content;\n  // Strip markdown code blocks if present\n  responseText = responseText.replace(/```json\\s*/gi, '').replace(/```\\s*/g, '').trim();\n  \n  let jsonMatch = responseText.match(/\\{[\\s\\S]*\\}/);\n  \n  if (!jsonMatch && responseText.includes('{')) {\n    let partial = responseText.substring(responseText.indexOf('{'));\n    if (!partial.endsWith('}')) {\n      partial = partial.replace(/,?\\s*$/, '') + '}';\n      partial = partial.replace(/(\\d+)\\.$/, '$1.0');\n      partial = partial.replace(/(\\d+)\\.\\s*}/, '$1.0}');\n    }\n    try {\n      JSON.parse(partial);\n      jsonMatch = [partial];\n    } catch(e2) {\n      const routeMatch = responseText.match(/\"route\"\\s*:\\s*\"(\\w+)\"/);\n      if (routeMatch) {\n        const validRoutes = ['support', 'sales', 'scheduling', 'billing', 'human', 'unclear'];\n        if (validRoutes.includes(routeMatch[1])) {\n          route = routeMatch[1];\n          confidence = 0.85;\n          reason = 'Extracted from truncated response';\n        }\n      }\n    }\n  }\n  \n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    const validRoutes = ['support', 'sales', 'scheduling', 'billing', 'human', 'unclear'];\n    if (parsed.route && validRoutes.includes(parsed.route)) {\n      route = parsed.route;\n    }\n    if (typeof parsed.confidence === 'number') {\n      confidence = parsed.confidence;\n    }\n    if (parsed.reason) {\n      reason = parsed.reason;\n    }\n  }\n} catch (e) {\n  // Keep defaults (human route)\n}\n\nreturn [{\n  json: {\n    ...msgData,\n    route,\n    confidence,\n    reason\n  }\n}];"
      },
