    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  COALESCE(\n    (SELECT string_agg(direction || ': ' || text, E'\\n' ORDER BY created_at ASC)\n     FROM (\n       SELECT direction, text, created_at\n       FROM chat_messages\n       WHERE user_id = $1\n       ORDER BY created_at DESC\n       LIMIT 10\n     ) recent),\n    'Sem historico anterior'\n  ) as conversation_context,\n  EXISTS(SELECT 1 FROM chat_messages WHERE user_id = $1 AND direction = 'out') as has_history",
        "options": {
          "queryReplacement": "={{ $json.user_id }}"
        }
      },
      "id": "pg-last10",
      "name": "Load Last 10 Messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1984,
        704
      ],
