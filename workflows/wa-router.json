        "operation": "executeQuery",
        "query": "SELECT cs.user_id, cs.instance, cs.active_flow, cs.step, cs.data, cs.updated_at, cs.expires_at\nFROM (SELECT $1::text as uid) q\nLEFT JOIN conversation_state cs ON cs.user_id = q.uid",
